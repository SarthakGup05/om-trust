# Om Charitable Trust — API Environment Variables
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/om_charitable_trust?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_change_in_production
CLIENT_URL=http://localhost:5173,http://localhost:5174,https://www.omcharitabletrust.net,https://omcharitabletrust.net

# Default Initial Admin Credentials (used to automatically seed initial admin if not present)
ADMIN_EMAIL=admin@omtrust.org
ADMIN_PASSWORD=AdminPassword123!
